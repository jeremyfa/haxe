<Project Sdk="Microsoft.NET.Sdk">
  <!-- A host with its own entry point, which calls the Haxe code like Unity does -->
  <Import Project="../bin/Sources.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Host.cs" />
    <!-- The resource files, embedded like the generated project does -->
    <EmbeddedResource Include="../bin/Resources/*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
